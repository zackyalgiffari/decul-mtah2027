{
  "permissions": {
    "deny": [
      "Read(./data/**)",
      "Read(~/mtah-data/**)",
      "Edit(./data/**)",
      "Edit(~/mtah-data/**)"
    ],
    "ask": [
      "Edit(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_data.py\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Decul data guard"
          }
        ]
      }
    ]
  }
}
